{
	"name": "highlight",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"icon": "resource/icon.png",
	"repository": {
		"url": "https://github.com/M1nt-Ch0c0/vscode-extension-highlight"
	},
	"author": {
		"name": "M1nt-Ch0c0"
	},
	"publisher": "M1nt-Ch0c0",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.47.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "highlight.selectedWords",
				"title": "%command.highlightSelectedWords.title%"
			},
			{
				"command": "highlight.clearWords",
				"title": "%command.clearHighlightWords.title%"
			}
		],
		"keybindings": [
			{
				"command": "highlight.selectedWords",
				"key": "shift+f8"
			},
			{
				"command": "highlight.clearWords",
				"key": "ctrl+shift+f8"
			}
		],
		"configuration": [
			{
				"title": "%config.title%",
				"properties": {
					"highlight.configuration.wholeWord": {
						"type": "boolean",
						"default": true,
						"description": "%config.wholeWord.description%"
					},
					"highlight.configuration.ignoreCase": {
						"type": "boolean",
						"default": false,
						"description": "%config.ignoreCase.description%"
					},
					"highlight.configuration.Bold": {
						"type": "boolean",
						"default": true,
						"description": "%config.bold.description%"
					},
					"highlight.configuration.borderRadius": {
						"type": "string",
						"default": "5px",
						"description": "%config.borderRadius.description%"
					},
					"highlight.configuration.colors": {
						"type": "array",
						"default": [
							{
								"light": "#b3d9ff",
								"dark": "#F5B041"
							},
							{
								"light": "#e6ffb3",
								"dark": "#FF9933"
							},
							{
								"light": "#b3b3ff",
								"dark": "#85C1E9"
							},
							{
								"light": "#ffd9b3",
								"dark": "#CD6155"
							},
							{
								"light": "#ffb3ff",
								"dark": "#AF7AC5"
							},
							{
								"light": "#b3ffb3",
								"dark": "#48C9B0"
							},
							{
								"light": "#ffff80",
								"dark": "#52BE80"
							},
							{
								"light": "#d1e0e0",
								"dark": "#F4D03F"
							}
						],
						"description": "%config.colors.description%"
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/vscode": "^1.47.0",
		"@types/glob": "^9.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.5.2",
		"eslint": "^9.36.0",
		"@typescript-eslint/parser": "^8.44.1",
		"@typescript-eslint/eslint-plugin": "^8.44.1",
		"glob": "^11.0.3",
		"mocha": "^11.7.2",
		"typescript": "^5.9.2",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.6.2"
	}
}
